-- OtterPad 关系化 schema（候选 1）。
-- 普通 8 表 + 索引在此声明（Drift 生成类型化行/companion）。
-- FTS5 虚表 + 同步触发器在 AppDatabase.onCreate 用 customStatement 建，
-- 避开 Drift 生成器对 jieba 自定义 tokenizer 的校验。
-- 设计决策见 DESIGN.md。

CREATE TABLE documents (
  id           TEXT NOT NULL PRIMARY KEY,
  title        TEXT NOT NULL,
  authors      TEXT NOT NULL,          -- JSON array
  journal      TEXT,
  year         TEXT,
  doi          TEXT,
  keywords     TEXT NOT NULL,         -- JSON array
  contentHash  TEXT,                   -- NULL = 无文件元数据条目
  addedAt      INTEGER NOT NULL        -- epoch ms
);
CREATE UNIQUE INDEX idx_documents_contentHash
  ON documents(contentHash) WHERE contentHash IS NOT NULL;
CREATE INDEX idx_documents_doi ON documents(doi);
CREATE INDEX idx_documents_addedAt ON documents(addedAt);

CREATE TABLE highlights (
  id         TEXT NOT NULL PRIMARY KEY,
  docId      TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
  content    TEXT NOT NULL,             -- 高亮文本（Highlight.text）
  note       TEXT,
  color      TEXT NOT NULL,
  groupId    TEXT,
  anchor     TEXT,
  createdAt  INTEGER NOT NULL
);
CREATE INDEX idx_highlights_docId ON highlights(docId);

CREATE TABLE history (
  docId        TEXT NOT NULL PRIMARY KEY REFERENCES documents(id) ON DELETE CASCADE,  -- unique = bubble 语义
  openedAt     INTEGER NOT NULL,
  progress     REAL NOT NULL DEFAULT 0,
  anchorBlock  INTEGER
);

CREATE TABLE favorites (
  id         TEXT NOT NULL PRIMARY KEY,  -- '_default_' = 默认收藏夹（派生 isDefault）
  emoji      TEXT NOT NULL,
  name       TEXT NOT NULL,
  createdAt  INTEGER NOT NULL
);

CREATE TABLE favorite_documents (
  favoriteId  TEXT NOT NULL REFERENCES favorites(id) ON DELETE CASCADE,
  docId       TEXT NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
  PRIMARY KEY (favoriteId, docId)
);

CREATE TABLE zotero_items (
  zoteroKey  TEXT NOT NULL PRIMARY KEY,
  docId      TEXT REFERENCES documents(id) ON DELETE CASCADE,
  version    INTEGER NOT NULL
);
CREATE INDEX idx_zotero_items_docId ON zotero_items(docId);

CREATE TABLE settings (
  settingKey  TEXT NOT NULL PRIMARY KEY,
  value       TEXT NOT NULL               -- JSON
);

CREATE TABLE meta (
  metaKey  TEXT NOT NULL PRIMARY KEY,
  value    TEXT NOT NULL               -- zotero_library_version 等 app 级标量
);

-- 翻译缓存（选区/段落/figure caption 翻译共用）。
-- cacheKey 由 TranslationService._buildCacheKey 产出（tr_<lang>_<hashCode>），
-- targetLang 已编码进 key，不单列。createdAt 驱动 7 天 TTL 过滤。
-- 全局缓存，不绑 documents（不 CASCADE）——文档删除不清理，与旧行为一致。
CREATE TABLE translations (
  cacheKey    TEXT NOT NULL PRIMARY KEY,
  translation TEXT NOT NULL,
  createdAt   INTEGER NOT NULL        -- epoch ms
);
CREATE INDEX idx_translations_createdAt ON translations(createdAt);
