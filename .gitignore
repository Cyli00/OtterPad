#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
untranslated.txt
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing
/android/key.properties
/android/app/release.jks
.ace-tool/

# Local machine / credentials — never commit
.claude/settings.local.json
**/auth.json
.env
.env.*
.npmrc
.pypirc
.netrc
credentials
secrets.*
id_rsa*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# PDB debug files
*.pdb

# Android JNI libraries (generated from Rust)
android/app/src/main/jniLibs/

# reference
/ref/

# archify review receipts (regenerable)
docs/diagrams/*.visual-check.*
docs/diagrams/*.delivery.json
docs/diagrams/*.review.json
