# vscode
/.vscode/
/.codex_tmp/
patch.txt
.gitconfig-codex
.codex_tmp*
/.agents/
# 仅纳入本次阅读器回归测试，其余本地测试保持忽略。
/test/*
!/test/reader_anchor_dom_test.cjs
!/test/reader_translation_dom_test.cjs
!/test/services/
/test/services/*
!/test/services/reader_document_index_test.dart
!/test/services/desktop_window_service_test.dart
!/test/providers/
/test/providers/*
!/test/providers/reader_shared_data_test.dart
!/test/pages/
/test/pages/*
!/test/pages/reader/
/test/pages/reader/*
!/test/pages/reader/reader_layout_test.dart
!/test/pages/reader/widgets/
/test/pages/reader/widgets/*
!/test/pages/reader/widgets/reader_incremental_translation_test.dart
!/test/widgets/
/test/widgets/*
!/test/widgets/adaptive_navigation_test.dart

# mcp
/mcps/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
untranslated.txt
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing
/android/key.properties
/android/app/release.jks
.ace-tool/

# Local machine / credentials — never commit
.claude/settings.local.json
**/auth.json

# PDB debug files
*.pdb

# Android JNI libraries (generated from Rust)
android/app/src/main/jniLibs/

# reference
/ref/
