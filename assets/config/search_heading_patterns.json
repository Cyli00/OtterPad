{
  "parsing": {
    "atx_heading": "^\\s{0,3}#{1,6}\\s*(.+?)\\s*#*\\s*$",
    "setext_underline": "^\\s{0,3}(?:=+|-+)\\s*$",
    "numbering_prefix": "^(?:section\\s+)?(?:\\d+(?:\\.\\d+)*|[ivxlcdm]+)\\s*[:.)-]?\\s+"
  },
  "heading_patterns": [
    {
      "display": "Abstract",
      "pattern": "^abstract$"
    },
    {
      "display": "Summary",
      "pattern": "^summary$"
    },
    {
      "display": "In Brief",
      "pattern": "^in brief$"
    },
    {
      "display": "Introduction",
      "pattern": "^(?:introduction|background)$"
    },
    {
      "display": "Methods",
      "pattern": "^(?:materials? and methods?|methods?|methodology)$"
    },
    {
      "display": "Methods",
      "pattern": "^(?:experimental (?:section|procedures?|design)|study design)$"
    },
    {
      "display": "Results",
      "pattern": "^(?:results?|findings)$"
    },
    {
      "display": "Results and Discussion",
      "pattern": "^results? and discussion$"
    },
    {
      "display": "Discussion",
      "pattern": "^(?:discussion|analysis)$"
    },
    {
      "display": "Conclusion",
      "pattern": "^(?:conclusions?|concluding remarks?)$"
    },
    {
      "display": "Conclusion",
      "pattern": "^(?:future work|outlook)$"
    }
  ],
  "reset_patterns": [
    "^(?:keywords?|acknowledg(?:e)?ments?|funding|author contributions?|data availability|ethics statement|ethics approval|conflicts? of interest|references?|bibliography|appendix|appendices|supplementary(?: materials?| information)?)$"
  ]
}
