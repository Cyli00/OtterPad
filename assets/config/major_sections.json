{
  "_comment": "主章节标题模式（MajorSectionMatcher）。匹配学术文献的顶级章节名；标题行命中才作为搜索结果的分组标签。模式为不含锚点的正则体，编号/Part 前缀与大小写由编译层统一处理。",
  "patterns": [
    "abstract",
    "graphical abstract",
    "highlights",
    "introduction",
    "background",
    "related works?",
    "literature review",
    "(?:materials?\\s+and\\s+)?methods?",
    "methodology",
    "experimental(?:\\s+(?:section|setup|procedures?))?",
    "theory",
    "results?(?:\\s+and\\s+discussions?)?",
    "discussions?(?:\\s+and\\s+conclusions?)?",
    "conclusions?",
    "summary(?:\\s+and\\s+outlook)?",
    "outlook",
    "perspectives?",
    "future\\s+(?:work|directions?|perspectives?)",
    "limitations?",
    "case\\s+stud(?:y|ies)",
    "evaluation",
    "implementation",
    "system\\s+(?:design|overview|architecture)",
    "part\\s+[a-z0-9ivx]+[.:．：]?.*",
    "(?:supplementary|supporting)\\s+(?:information|materials?)",
    "appendix(?:\\s+[a-z])?",
    "references?",
    "bibliography",
    "acknowledg?ements?",
    "author\\s+contributions?",
    "conflicts?\\s+of\\s+interest",
    "data\\s+availability(?:\\s+statement)?",
    "摘要",
    "引言",
    "绪论",
    "前言",
    "背景",
    "研究背景",
    "相关工作",
    "文献综述",
    "(?:材料与)?方法",
    "研究方法",
    "实验(?:与方法|方法|部分|设计)?",
    "理论(?:基础|分析)?",
    "结果(?:与讨论)?",
    "讨论",
    "结论(?:与展望)?",
    "总结(?:与展望)?",
    "展望",
    "局限性?",
    "参考文献",
    "致谢",
    "附录"
  ]
}
